[Unit]
Description=TVDecoder OS Fullscreen Kiosk Session
After=systemd-user-sessions.service network-online.target sound.target
Wants=network-online.target sound.target

[Service]
Type=simple
User=tvuser
Group=tvuser
PAMName=login
WorkingDirectory=/home/tvuser
Environment=DISPLAY=:0
Environment=XDG_SESSION_TYPE=x11
ExecStartPre=/bin/sh -c 'clear > /dev/tty1 2>/dev/null || true'
ExecStart=/usr/bin/xinit /opt/tvdecoder/config/kiosk.sh -- :0 vt1 -nocursor -keeptty -quiet -novtswitch
Restart=always
RestartSec=2
StandardInput=null
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVTDisallocate=yes

[Install]
WantedBy=graphical.target
