[Unit]
Description=Aurora OS Fullscreen Kiosk Session
After=systemd-user-sessions.service sound.target network.target
Wants=sound.target

[Service]
Type=simple
User=tvuser
Group=tvuser
PAMName=login
WorkingDirectory=/home/tvuser
Environment=DISPLAY=:0
Environment=XDG_SESSION_TYPE=x11
ExecStartPre=/bin/sh -c 'clear > /dev/tty1 2>/dev/null || true'
ExecStart=/opt/tvdecoder/config/session_launcher.sh
Restart=always
RestartSec=2
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVTDisallocate=yes

[Install]
WantedBy=graphical.target multi-user.target
