[Plymouth Theme]
Name=Aurora OS
Description=Aurora OS Boot Splash with Progress Bar
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/aurora
HorizontalAlignment=.5
VerticalAlignment=.42
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.58
ProgressBarNumberOfCols=1
ProgressBarNumberOfRows=1
