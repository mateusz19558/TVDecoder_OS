#!/usr/bin/env bash
# ==============================================================================
# TVDecoder OS - Natywny Runner Dekodera TV (100% Linux, ZERO HTML, ZERO WINE)
# ==============================================================================

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$APP_DIR" || exit 1

export DISPLAY="${DISPLAY:-:0}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"
export QT_QPA_PLATFORM="xcb"

echo "=================================================================="
echo " 🚀 Start Natywnego Programu TVDecoder (Pure Native STB App)     "
echo " Zero HTML • Zero Emulacji Wine • 100% Natywny Kod Programu      "
echo "=================================================================="

# Uruchomienie w 100% natywnego programu napisanego w kodzie
exec python3 "$APP_DIR/tvdecoder_native.py" "$@"
