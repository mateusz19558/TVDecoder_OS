#!/usr/bin/env python3
# ==============================================================================
# TVDecoder OS - Główny Natywny Program Dekodera (Aurora OS Linux Appliance)
# Zero Wine • 100% Natywny Podsystem Linux • Pełny Interfejs Aurora TV
# ==============================================================================

import os
import sys
import time
import signal
import subprocess
import urllib.request

APP_DIR = os.path.dirname(os.path.abspath(__file__))
subprocesses = []

def cleanup(signum=None, frame=None):
    print("\n[TVDecoder] Zamykanie aplikacji Aurora OS...", flush=True)
    for p in subprocesses:
        try:
            p.terminate()
            p.wait(timeout=1.5)
        except Exception:
            try:
                p.kill()
            except Exception:
                pass
    sys.exit(0)

signal.signal(signal.SIGINT, cleanup)
signal.signal(signal.SIGTERM, cleanup)

def wait_for_server(url, timeout=10.0):
    start = time.time()
    while time.time() - start < timeout:
        try:
            with urllib.request.urlopen(url, timeout=0.5) as resp:
                if resp.status == 200:
                    return True
        except Exception:
            time.sleep(0.15)
    return False

def main():
    os.chdir(APP_DIR)
    print("==================================================================", flush=True)
    print(" 🚀 Start Dekodera TV - Aurora OS (Natywny Kiosk Appliance)       ", flush=True)
    print(" Pełny Koncept Aurora UI • Brak emulacji Wine • 100% Linux       ", flush=True)
    print("==================================================================", flush=True)

    # 1. Start wbudowanego serwera aplikacji i mostka pilota
    server_script = os.path.join(APP_DIR, "tvdecoder_server.py")
    if os.path.exists(server_script):
        p_server = subprocess.Popen([sys.executable, server_script])
        subprocesses.append(p_server)
    else:
        print("[TVDecoder] Błąd: Brak pliku tvdecoder_server.py!", flush=True)
        sys.exit(1)

    wait_for_server("http://127.0.0.1:8080/")

    # 2. Start mostka pilota Apple TV (HomeKit HAP)
    apple_bridge_script = os.path.join(APP_DIR, "apple_tv_bridge.py")
    if os.path.exists(apple_bridge_script):
        try:
            p_apple = subprocess.Popen([sys.executable, apple_bridge_script])
            subprocesses.append(p_apple)
        except Exception as e:
            print(f"[TVDecoder] Ostrzeżenie: Mostek Apple: {e}", flush=True)

    # 3. Uruchomienie interfejsu Aurora OS w dedykowanym trybie Kiosk STB
    gui_url = "http://127.0.0.1:8080/"

    # Sprawdzenie dostępnych silników wyświetlania w systemie Linux
    browser_cmd = None
    for cand in ["chromium", "chromium-browser", "google-chrome"]:
        if subprocess.run(["which", cand], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            browser_cmd = cand
            break

    if browser_cmd:
        flags = [
            browser_cmd,
            "--kiosk",
            "--app=" + gui_url,
            "--no-first-run",
            "--no-default-browser-check",
            "--disable-infobars",
            "--disable-translate",
            "--disable-features=Translate",
            "--disable-pinch",
            "--overscroll-history-navigation=0",
            "--autoplay-policy=no-user-gesture-required",
            "--disable-web-security",
            "--allow-running-insecure-content",
            "--enable-gpu-rasterization",
            "--enable-zero-copy",
            "--ignore-gpu-blocklist",
            "--check-for-update-interval=31536000",
            "--user-data-dir=/home/tvuser/.config/tvdecoder_profile"
        ]
        p_gui = subprocess.Popen(flags)
        subprocesses.append(p_gui)
        p_gui.wait()

    cleanup()

if __name__ == "__main__":
    main()
